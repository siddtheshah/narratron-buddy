  "renderScale": 1.15,
  "fillLight": 0.6,
  "hoverGlow": {
    "material": "CosmicCore",
    "intensity": 3.4,
    "light": { "name": "SparkLight", "intensity": 6.2 }
  },
  "shaders": [
    {
      "attachTo": "NebulaAnchor",
      "geometry": { "type": "sphere", "widthSegments": 32, "heightSegments": 24 },
      "scale": 0.92,
      "vertex": "shaders/dust.vert",
      "fragment": "shaders/dust.frag",
      "transparent": true,
      "depthWrite": false,
      "uniforms": {
        "sparkColor": { "source": "lightColor" },
        "sparkStrength": { "rest": 0.72, "hover": 1.55 }
      }
    },
    {
      "attachTo": "SparkLight",
      "geometry": { "type": "sphere", "widthSegments": 28, "heightSegments": 20 },
      "scale": 0.16,
      "vertex": "shaders/dust.vert",
      "fragment": "shaders/spark.frag",
      "transparent": true,
      "depthWrite": false,
      "uniforms": {
        "sparkColor": { "source": "lightColor" },
        "sparkStrength": { "rest": 0.55, "hover": 1.45 }
      }
    }
  ]
}
