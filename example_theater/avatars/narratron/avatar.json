  "actions": [
    {
      "id": "idle",
      "label": "Idle",
      "clip": "Idle",
      "loop": true,
      "lightColor": "#7ce8ff",
      "description": "Serene cosmic float, gentle breath, and orbiting pages."
    },
    {
      "id": "greeting",
      "label": "Greeting",
      "clip": "Greeting",
      "loop": false,
      "lightColor": "#ffd27d",
      "description": "Welcoming bow, open wave, and quill flourish."
    },
    {
      "id": "amused",
      "label": "Amused",
      "clip": "Amused",
      "loop": false,
      "lightColor": "#e29cff",
      "description": "Playful chuckle bounce and lively orbiting pages."
    },
    {
      "id": "surprised",
      "label": "Surprised",
      "clip": "Surprised",
      "loop": false,
      "lightColor": "#d6f6ff",
      "description": "Startled lift, wide eyes, and radiant flare."
    },
    {
      "id": "confused",
      "label": "Confused",
      "clip": "Confused",
      "loop": false,
      "lightColor": "#9aa8ff",
      "description": "Curious head-tilt and pondering quill tap."
    },
    {
      "id": "at-work",
      "label": "At Work",
      "clip": "AtWork",
      "loop": true,
      "lightColor": "#45d9ff",
      "description": "Focused lean over the scroll with brisk writing."
    }
