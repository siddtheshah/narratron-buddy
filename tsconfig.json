{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rootDir": ".",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "/static/generated/canvas/*": ["./frontend/canvas/*"],
      "/static/js/*": ["./static/js/*"],
      "/static/js/image-effects.js?v=effects-20261005-1": ["./frontend/canvas/image-effects.d.ts"],
      "/static/js/animation-effects.js": ["./frontend/canvas/animation-effects.d.ts"]
    }
  },
  "include": [
    "playwright.config.ts",
    "testing/ui/**/*.ts",
    "frontend/canvas/**/*.ts",
    "frontend/canvas/**/*.js",
    "frontend/canvas/**/*.d.ts"
  ]
}
