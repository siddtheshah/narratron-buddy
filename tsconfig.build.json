{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "composite": true,
    "rootDir": "frontend",
    "outDir": "frontend/static/generated",
    "tsBuildInfoFile": "frontend/static/generated/.tsbuildinfo",
    "noEmit": false,
    "sourceMap": true,
    "inlineSources": true,
    "declaration": true,
    "declarationMap": false
  },
  "include": [
    "frontend/**/*.ts"
  ],
  "exclude": [
    "frontend/**/*_test.ts",
    "frontend/testing/**",
    "frontend/static/**",
    "frontend/templates/**"
  ]
}
