{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "rootDir": "frontend/canvas",
    "outDir": "static/generated/canvas",
    "noEmit": false,
    "sourceMap": true,
    "inlineSources": true,
    "declaration": false
  },
  "include": [
    "frontend/canvas/**/*.ts",
    "frontend/canvas/**/*.d.ts"
  ],
  "exclude": [
    "frontend/canvas/**/*_test.ts"
  ]
}
