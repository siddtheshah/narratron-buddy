{
  "id": "light-cube",
  "title": "Cube of Light",
  "model": "model.glb",
  "poster": "preview.webp",
  "idle": "idle",
  "actions": [
    { "id": "idle", "label": "Gold", "clip": "SlowTurn", "loop": true, "lightColor": "#ffc477" },
    { "id": "ember", "label": "Ember", "lightColor": "#ff5940" },
    { "id": "emerald", "label": "Emerald", "lightColor": "#46f391" },
    { "id": "cyan", "label": "Cyan", "lightColor": "#41dfff" },
    { "id": "violet", "label": "Violet", "lightColor": "#b47aff" },
    { "id": "frost", "label": "Frost", "lightColor": "#d2eaff" }
  ],
  "renderScale": 0.8,
  "fillLight": 0.24,
  "hoverGlow": {
    "material": "InnerLight",
    "intensity": 4,
    "light": { "name": "SparkLight", "intensity": 7.875 }
  },
  "shaders": [
    {
      "attachTo": "SparkLight",
      "geometry": { "type": "sphere", "widthSegments": 32, "heightSegments": 24 },
      "scale": 0.36,
      "vertex": "shaders/dust.vert",
      "fragment": "shaders/dust.frag",
      "transparent": true,
      "depthWrite": false,
      "uniforms": {
        "sparkColor": { "source": "lightColor" },
        "sparkStrength": { "rest": 0.62, "hover": 1.74 }
      }
    }
  ]
}
